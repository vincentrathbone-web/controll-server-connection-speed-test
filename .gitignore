controll-server-monitor/data/*.sqlite
controll-server-monitor-rs/*.sqlite

# Packaged/versioned release zips (rebuilt via package.ps1 / build.ps1)
*.zip

# Env files (never commit secrets)
.env*
!.env.example

# OS / editor
.DS_Store
*.log
.claude/settings.local.json
